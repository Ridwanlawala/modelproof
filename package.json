{
  "name": "modelproof",
  "version": "0.1.0",
  "private": true,
  "description": "ModelProof: browser-only, verifiable AI model provenance. Chunked SHA-256 + Merkle root, Ed25519-signed manifests, permanent storage on Arweave.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
